# ---- Required ----
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
OWNER_ID=123456789
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?retryWrites=true&w=majority

# Needed for Stream mode / range autoposter (https://my.telegram.org -> API development tools)
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# ---- VPS (docker compose + Caddy) ----
# Your domain (A record must point to the VPS IP). Caddy gets the HTTPS certificate automatically.
# docker-compose.yml sets BASE_URL=https://$DOMAIN for you.
DOMAIN=bot.example.com

# Only when you do NOT use docker compose (own reverse proxy / Koyeb / Render): public https URL, no trailing slash
# BASE_URL=https://bot.example.com

# ---- Optional ----
# Permanent share links through a Cloudflare Worker
# WORKER_URL=https://your-worker.your-name.workers.dev
# WORKER_SECRET=same-long-random-text-as-in-the-worker
DB_NAME=filesharebot
MONGO_LIMIT_MB=512

# ---- More than one MongoDB cluster (optional) - spreads the per-click writes over several free clusters ----
# MONGO_URI above = CORE = YOURS. Users, links, files, settings, the server list / gateway lease and the saved user-account session
# can NEVER be moved to another cluster (hard-coded), so a friend's cluster only ever holds expendable counters.
# MONGO_URI_2=mongodb+srv://user:pass@friend-cluster-1.mongodb.net/?retryWrites=true&w=majority   # "hot":  daily limit counters, ad sessions, daily stats, auto-delete queue
# MONGO_URI_3=mongodb+srv://user:pass@friend-cluster-2.mongodb.net/?retryWrites=true&w=majority   # "logs": VPS usage + cluster statistics (without it these go to "hot")
# DB_NAME_2=filesharebot       # default = DB_NAME (use a database name nobody else uses on that cluster)
# DB_NAME_3=filesharebot
# MONGO_LIMIT_MB_2=512         # quota of that cluster, for the storage bar in Stats
# MONGO_LIMIT_MB_3=512
# MONGO_ROUTES=                # optional override, e.g. daily_stats=logs,pending_deletes=core   (users/links/settings/... are refused)
# MONGO_MAX_POOL=5            # connections per server per cluster (Atlas free tiers allow 500 IN TOTAL for all servers together)
# MONGO_SECONDARY_TIMEOUT_MS=4000   # after this a dead extra cluster is skipped and core serves its collections
LOG_LEVEL=INFO

# Invisible padding that makes message bubbles as wide as their buttons (0 = off, raise/lower to tune)
# PAD_WIDTH=34

# ---- Landing page channel buttons ----
HOME_CHANNELS=Pookie Hub=https://t.me/+5E10CZrWvowxZTVh;Lust Corner=https://t.me/+ti_epAxMFjs2NmRl;Desi Hub=https://t.me/+t4myZzSf3cc3Nzll;Premium Hub=https://t.me/+6cF9UNXYortjMzk1;Trending Reels=https://t.me/+GP2Y_iUBhe83NzVl

# ---- One domain for all servers (Cloudflare Worker in front, see cloudflare-worker/README.md) ----
# PUBLIC_URL=https://hubpa.com

# ---- Multi-server mode (several servers, ONE bot, ONE database). Leave CLUSTER_SECRET empty for a single server. ----
# Same BOT_TOKEN / MONGO_URI / API_ID / API_HASH / OWNER_ID / CLUSTER_SECRET on every server. Different on each: NODE_ID, DOMAIN.
# NODE_ROLE=gateway on TWO servers (one is active, the other a hot standby that takes over by itself), worker on the rest.
# CLUSTER_SECRET=            # min 24 characters:  openssl rand -hex 32
# NODE_ID=n1                 # unique on every server: n1, n2, n3 ...
# NODE_ROLE=gateway          # gateway | worker
# NODE_NAME=
# NODE_CAPACITY=10           # soft number used for routing
# NODE_MAX_TASKS=10          # soft number used for routing
# NODE_MAX_STREAMS=8         # soft number used for routing
# NODE_HARD_TASKS=10          # real limit where a server answers 503 (0 = automatic: 4 x the soft number)
# NODE_HARD_STREAMS=0        # same for Stream/Download viewers
# ACTIVE_WINDOW=300
# DRAIN_SECONDS=12           # on shutdown: wait this long for running requests (keep below docker stop_grace_period)
# CLUSTER_ALLOW_LEGACY=1     # ONLY while updating from an old version: accept servers that still send the raw secret. Remove afterwards!

# ---- Protection (optional) ----
# DL_RATE_PER_10S=60         # per-IP limit for /dl/... (0 = off)
# ORIGIN_SECRET=             # same text as in the Cloudflare Worker; with PUBLIC_URL set, /dl and /<token> answer only the Worker
# CLUSTER_ALLOW=             # Caddy: public IPs of the gateway servers allowed to call /internal/update (space separated)
# TG_ALLOW=                  # Caddy: "149.154.160.0/20 91.108.4.0/22" = only Telegram may call the webhook (not behind Cloudflare proxy)
